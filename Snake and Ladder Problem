#include <bits/stdc++.h>
using namespace std;

class Solution{
public:
    int find(int pos, unordered_map<int,int> posMap, vector<int>*memo)
    {
        if(pos>=30)
            return 0;
        if((*memo)[pos]!=-1)
            return (*memo)[pos];
        int k, curSteps=INT_MAX/6, nextPos=0;
        for(k=1;k<=6;k++)
        {
            nextPos = pos+k;
            if(posMap.find(nextPos)!=posMap.end())
            {
                if(posMap[nextPos]<nextPos)
                    continue;
                nextPos = posMap[nextPos];
            }
            curSteps = min(curSteps,1+find(nextPos,posMap,memo));
        }
        (*memo)[pos] = curSteps;
        return (*memo)[pos];
    }
    int minThrow(int n, int arr[])
    {
        vector<int> memo(31,-1);
        int i=0;
        unordered_map<int,int> cellDest;
        for(i=0;i<n;i++)
        {
            cellDest[arr[2*i]]= arr[2*i+1];
        }
        return find(1,cellDest,&memo);
    }
};

